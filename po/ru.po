#, fuzzy, c-format
msgid "The provided stream is not a sudoku puzzle.\n"
msgstr "Поток не является судоку-головоломкой.\n"

#: src/main.c:667
#, fuzzy, c-format
msgid "To export sudokus, please compile with '--enable-cairo'.\n"
msgstr ""
"Чтобы использовать функцию вывода, скомпилируйте с параметром --enable-"
"cairo.\n"

#: src/main.c:135
#, fuzzy, c-format
