#, c-format
msgid "Options:\n"
msgstr "Параметры:\n"

#: src/main.c:875
msgid "Provided hint"
msgstr "Предоставлена подсказка"

#: src/main.c:888
msgid "Saved!"
msgstr "Сохранено!"

#: src/main.c:790 src/main.c:832
