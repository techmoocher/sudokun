#: src/main.c:498
msgid " G - Save\n"
msgstr " G - Kaydet\n"

#: src/main.c:492
msgid " H - Give a hint\n"
msgstr " H - İpucu ver\n"

#: src/main.c:497
msgid " N - New puzzle\n"
msgstr " N - Yeni bulmaca\n"

#: src/main.c:499
msgid " Q - Quit\n"
msgstr " Q - Çıkış\n"

#: src/main.c:501
msgid " S - Solve puzzle\n"
msgstr " S - Bulmacayı çöz\n"

#: src/main.c:491
msgid " c - Check solution\n"
msgstr " c - Çözümü denetle\n"

#: src/main.c:486
msgid " h - Move left\n"
msgstr " h - Sola git\n"

#: src/main.c:487
msgid " j - Move down\n"
msgstr " j - Aşağı git\n"

#: src/main.c:488
msgid " k - Move up\n"
msgstr " k - Yukarı git\n"

#: src/main.c:489
msgid ""
" l - Move right\n"
"\n"
msgstr ""
" l - Sağa git\n"
"\n"

#: src/main.c:495
msgid " m - Toggle marks\n"
msgstr " m - İşaretleri aç/kapat\n"

#: src/main.c:500
msgid " r - Redraw\n"
msgstr " r - Yeniden çiz\n"

#: src/main.c:503
msgid " u - Undo previous action\n"
msgstr " u - Önceki eylemi geri al\n"

#: src/main.c:837
#, c-format
msgid " with the help of %d hints"
msgstr "%d ipucu yardımıyla"

#: src/main.c:502
msgid " x - Delete number\n"
msgstr " x - Sayıyı sil\n"

#: src/main.c:124
#, c-format
msgid "-P filename:\t\tOutput PNG image\n"
msgstr "-P dosyaadı:\t\tPNG resmi olarak dışa aktar\n"

#: src/main.c:123
#, c-format
msgid ""
"-S papername:\t\tPDF paper size (e.g., 'a4', 'letter', 'legal'; default "
"'a4') or 'WIDTHxHEIGHT[unit]'\n"
msgstr ""
"-S sayfaboyutu:\t\tPDF sayfa boyutu (örn., 'a4', 'letter', 'legal'; "
"öntanımlı 'a4') veya 'GENİŞLİKxYÜKSEKLİK[birim]'\n"

#: src/main.c:118
#, c-format
msgid "-c nocolor:\t\tDo not use colors\n"
msgstr "-c:\t\tRenkler kullanılmasın\n"

#: src/main.c:120
#, c-format
msgid "-d difficulty:\t\tChoose between: easy, normal, hard\n"
msgstr "-d zorluk:\t\tZorluk derecesini seç: easy, normal, hard\n"

#: src/main.c:116
#, c-format
msgid "-h help:\t\tPrint this help\n"
msgstr "-h:\t\tYardım metnini yazdır\n"

#: src/main.c:119
#, c-format
msgid "-o output:\t\tOutput stream (inverse of -s)\n"
msgstr "-o:\t\tTahtayı dışa aktar (-s seçeneğinin tersi)\n"

#: src/main.c:122
#, c-format
msgid "-p filename:\t\tOutput PDF\n"
msgstr "-p dosyaadı:\t\tPDF olarak dışa aktar\n"

#: src/main.c:117
#, c-format
msgid "-r resume:\t\tResume the last saved game\n"
msgstr "-r:\t\tSon kaydedilen oyuna devam et\n"

#: src/main.c:121
#, c-format
msgid "-s stream:\t\tUser provided sudoku stream\n"
msgstr "-s tahta:\t\tBelirtilen sudoku tahtasını kullan\n"

#: src/main.c:115
#, c-format
msgid "-v version:\t\tPrint version\n"
msgstr "-v:\t\tSürüm numarasını yazdır\n"

#: src/main.c:891
msgid "Can't save the game!"
msgstr "Oyun kaydedilemiyor!"

#: src/main.c:490
msgid "Commands\n"
msgstr "Komutlar\n"

#: src/main.c:845
msgid "Correct so far"
msgstr "Şimdiye kadar doğru"

#: src/main.c:317
#, c-format
msgid "Game save is missing or corrupted, try starting new game.\n"
msgstr "Oyun kaydı eksik veya bozuk, yeni oyun başlatmayı deneyin.\n"

#: src/main.c:800
msgid "Generating puzzle..."
msgstr "Bulmaca oluşturuluyor..."

#: src/main.c:485
msgid "Movement\n"
msgstr "Hareket\n"

#: src/main.c:826
msgid "Not correct"
msgstr "Doğru değil"

#: src/main.c:114
#, c-format
msgid "Options:\n"
msgstr "Seçenekler:\n"

#: src/main.c:875
msgid "Provided hint"
msgstr "İpucu verildi"

#: src/main.c:888
msgid "Saved!"
msgstr "Kaydedildi!"

#: src/main.c:790 src/main.c:832
msgid "Solved"
msgstr "Çözüldü"

#: src/main.c:784
msgid "Solving puzzle..."
msgstr "Bulmaca çözülüyor..."

